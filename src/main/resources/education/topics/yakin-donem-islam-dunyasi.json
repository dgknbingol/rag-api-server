{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Yakın Dönem İslam Dünyası",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Yakın Dönem İslam Dünyası Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yakın Dönem İslam Dünyası, yaklaşık 18. yüzyıldan günümüze kadar Müslüman toplumların yaşadığı siyasi, sosyal, ekonomik ve kültürel gelişmeleri ifade eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu dönemde İslam dünyası;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sömürgecilik hareketleriyle karşılaşmış,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bağımsızlık mücadeleleri vermiş,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yeni devletler kurulmuş,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğitim, bilim ve teknoloji alanlarında yeniden gelişme çabalarına yönelmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Osmanlı Devleti'nin Son Dönemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ve 19. yüzyıllarda Osmanlı Devleti;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Uzun süren savaşlar,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ekonomik sorunlar,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Milliyetçilik hareketleri,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Avrupa'nın bilim ve sanayide ilerlemesi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "gibi nedenlerle zayıflamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "I. Dünya Savaşı'nın ardından Osmanlı Devleti sona ermiş ve Türkiye Cumhuriyeti 1923 yılında kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Sömürgecilik Dönemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ve 20. yüzyıllarda birçok İslam ülkesi;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İngiltere,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Fransa,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hollanda,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İtalya",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "gibi Avrupa devletlerinin sömürgesi veya nüfuzu altına girmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu durum;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ekonomik sıkıntılara,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğitimde gerilemeye,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Siyasi bağımsızlığın kaybedilmesine",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "neden olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bağımsızlık Mücadeleleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "yüzyılda birçok Müslüman toplum bağımsızlık mücadelesi vermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sonuç olarak;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Pakistan,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Endonezya,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cezayir,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Libya,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tunus",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "gibi birçok ülke bağımsızlığını kazanmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İslam Dünyasında Eğitim ve Bilim",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yakın dönemde birçok İslam ülkesi;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Üniversiteler kurmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bilimsel araştırmaları desteklemiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Teknolojiye yatırım yapmaya başlamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğitim sistemlerini geliştirmeye çalışmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bununla birlikte bazı bölgelerde savaşlar ve ekonomik sorunlar gelişmeyi olumsuz etkilemiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İslam İş Birliği Teşkilatı (İİT)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam İş Birliği Teşkilatı (İİT), Müslüman ülkeler arasında dayanışmayı güçlendirmek amacıyla 1969 yılında kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başlıca amaçları:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Üye ülkeler arasında iş birliğini artırmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Barış ve dayanışmayı desteklemek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğitim, ekonomi ve kültür alanlarında ortak çalışmalar yürütmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslüman toplumların ortak meselelerine çözüm aramak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Günümüzde İslam Dünyası",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bugün İslam dünyası;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Farklı kıtalarda yaşayan milyarlarca Müslümandan oluşmaktadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bilim, eğitim ve teknoloji alanlarında gelişmeye devam etmektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yardımlaşma ve dayanışma faaliyetlerini sürdürmektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Aynı zamanda bazı bölgelerde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Savaşlar,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Göç,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yoksulluk,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğal afetler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "gibi sorunlarla da mücadele edilmektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Yakın Dönemden Alınacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yakın dönem bizlere önemli mesajlar verir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Birlik ve beraberlik güçlü toplumların temelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğitim ve bilim kalkınmanın anahtarıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bağımsızlık ve özgürlük önemlidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Barış, adalet ve kardeşlik korunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslümanlar yardımlaşma ve dayanışma içinde olmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Hep birlikte Allah'ın ipine sımsıkı sarılın; parçalanmayın.\"\n(Âl-i İmrân Suresi, 3/103)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"İyilik ve takva üzerinde yardımlaşın.\"\n(Mâide Suresi, 5/2)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, Müslümanların birlik, beraberlik ve yardımlaşma içinde olmalarının önemini vurgulamaktadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yakın Dönem İslam Dünyası, yaklaşık 18. yüzyıldan günümüze kadar olan süreci kapsar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu dönemde birçok İslam ülkesi sömürge yönetimleri altında kalmış, ardından bağımsızlık mücadelesi vermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Türkiye Cumhuriyeti 1923 yılında kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam İş Birliği Teşkilatı (İİT), 1969 yılında Müslüman ülkeler arasındaki iş birliğini artırmak amacıyla kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğitim, bilim ve teknolojiye yatırım yapmak, İslam dünyasının gelişmesi için önemli görülmektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yakın Dönem İslam Dünyası, 18. yüzyıldan günümüze kadar Müslüman toplumların yaşadığı önemli siyasi, sosyal ve kültürel gelişmeleri kapsar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu dönemde birçok İslam ülkesi sömürge yönetimleri altında kalmış, daha sonra bağımsızlıklarını kazanmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Osmanlı Devleti'nin sona ermesiyle Türkiye Cumhuriyeti kurulmuş, birçok Müslüman ülke de modern devlet yapıları oluşturmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam İş Birliği Teşkilatı, Müslüman ülkeler arasında dayanışmayı güçlendirmek amacıyla kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günümüzde İslam dünyası; eğitim, bilim, teknoloji ve ekonomik kalkınma alanlarında ilerlemeye çalışırken, savaş, göç ve yoksulluk gibi sorunlarla da mücadele etmektedir.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
