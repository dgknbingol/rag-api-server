{
  "readingMinutes": 3,
  "blocks": [
    {
      "type": "heading",
      "text": "İdğam",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İdğam Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam, tecvid kurallarından biridir ve cezmli nûn (نْ) veya tenvinden sonra, belirli harflerden biri geldiğinde nûn sesinin kendisinden sonraki harfe katılarak okunmasına denir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"İdğam\" kelimesi Arapçada \"birleştirmek, içine katmak\" anlamına gelir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam sayesinde okuma daha akıcı ve doğal hâle gelir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İdğam Neden Yapılır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'in doğru okunmasını sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okumaya akıcılık kazandırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin doğal şekilde birbirine geçmesini sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed'in (sav) öğrettiği okuyuşa uygun okumaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İdğam Hangi Durumlarda Yapılır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam, cezmli nûn (نْ) veya tenvinden sonra aşağıdaki altı harften biri geldiğinde uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam harfleri şunlardır:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ي، ر، م، ل، و، ن",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu harfler şu şekilde kolayca ezberlenebilir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "يرملون",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İdğam Çeşitleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam ikiye ayrılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "1. Gunne (Geniz Sesi) ile İdğam",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Aşağıdaki harflerde idğam yapılırken iki hareke miktarı gunne uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ي، ن، م، و",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "مَنْ يَقُولُ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "مِنْ مَالٍ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "غَفُورٌ وَدُودٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu örneklerde nûn sesi sonraki harfe katılarak, geniz sesiyle okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "2. Gunnesiz İdğam",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Aşağıdaki harflerde idğam yapılırken gunne yapılmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ل، ر",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "مِنْ رَبِّهِمْ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "مِنْ لَدُنْهُ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu örneklerde nûn sesi sonraki harfe katılır; ancak geniz sesi kullanılmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İdğam Nasıl Okunur?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam uygulanırken;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi ayrı okunmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sonraki harfe katılarak okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gunne gereken yerlerde iki hareke miktarı geniz sesi yapılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gunnesiz idğamda doğrudan sonraki harfe geçilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İdğam Okurken Nelere Dikkat Edilmelidir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam harfleri doğru tanınmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gunne gereken yerlerde geniz sesi uygulanmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gunnesiz idğam ile gunneli idğam karıştırılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi gereksiz yere uzatılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin mahreci korunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Sık Yapılan Hatalar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesini tamamen açık okumak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gunne gereken yerde gunne yapmamak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gunnesiz idğamda geniz sesi kullanmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam yapılması gereken yerde izhar gibi okumak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru idğamda nûn sesi sonraki harfe doğal bir şekilde katılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an ve Hadislerde Kur'an'ı Güzel Okumanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı tane tane, ağır ağır oku.\"\n(Müzzemmil Suresi, 73/4)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı seslerinizle güzelleştiriniz.\" (Ebû Dâvûd, Vitir)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam, cezmli nûn veya tenvinden sonra gelen bazı harflerde nûn sesinin sonraki harfe katılmasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam harfleri altıdır: ي، ر، م، ل، و، ن",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ي، ن، م، و harflerinde gunneli idğam uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ل، ر harflerinde gunnesiz idğam uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru idğam, Kur'an'ın daha akıcı ve usulüne uygun okunmasına katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam, cezmli nûn veya tenvinden sonra belirli harfler geldiğinde uygulanan bir tecvid kuralıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu kuralda nûn sesi kendisinden sonraki harfe katılarak okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam iki çeşittir: gunneli idğam ve gunnesiz idğam.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gunneli idğam ي، ن، م، و harflerinde; gunnesiz idğam ise ل، ر harflerinde uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam kurallarını doğru uygulamak, Kur'an-ı Kerim'i daha doğru ve akıcı okumaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
