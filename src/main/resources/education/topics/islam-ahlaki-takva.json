{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Takva",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Takva Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva, Allah'a karşı saygı ve sorumluluk bilinciyle hareket etmek, O'nun emirlerine uymak ve yasaklarından sakınmaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva sahibi kişi, Allah'ın kendisini her an gördüğünü bilir ve hayatını buna göre yaşamaya gayret eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam ahlakında takva, müminin en önemli özelliklerinden biri olarak kabul edilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İslam'da Takvanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva, Allah'a yakınlaşmanın en önemli yollarından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva sahibi bir Müslüman;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın emirlerini yerine getirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günahlardan kaçınmaya çalışır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru ve dürüst davranır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kul hakkına dikkat eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Güzel ahlak sahibi olmaya gayret eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de birçok ayette takva övülmüş ve Müslümanlara tavsiye edilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Takva Sahibi Kişinin Özellikleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva sahibi kişi;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru sözlüdür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Güvenilirdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Adaletlidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sabırlıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Merhametlidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yardımseverdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günahlardan uzak durmaya çalışır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın rızasını her şeyin üzerinde tutar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Takvaya Ulaşmanın Yolları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takvayı geliştirmek için:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namazı düzenli kılmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an okumak ve anlamaya çalışmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dua etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal kazanç elde etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Haramlardan kaçınmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Güzel ahlak sahibi olmaya çalışmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tövbe ve istiğfar etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İnsanlara iyilik yapmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Peygamberimizin Takvası",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav), takvanın en güzel örneğidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "O;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın emirlerini eksiksiz yerine getirmiş,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günahlardan sakınmış,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İnsanlara karşı adaletli ve merhametli davranmış,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her işinde Allah'ın rızasını gözetmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu nedenle Müslümanlar için en güzel örnektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Takvanın Faydaları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva sahibi kişi;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın sevgisini kazanmaya çalışır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kalp huzuru yaşar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günahlardan uzak durur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Güzel ahlak sahibi olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Toplumda güvenilir biri olarak tanınır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Günlük Hayatta Takvaya Örnekler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kimse görmese bile haramdan uzak durmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kul hakkına dikkat etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Alışverişte dürüst davranmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yalan söylememek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Emanete sahip çıkmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İsraf etmemek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anne ve babaya saygılı olmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Şüphesiz Allah katında en üstün olanınız, O'na karşı gelmekten en çok sakınanınızdır (en takvalı olanınızdır).\"\n(Hucurât Suresi, 49/13)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kim Allah'a karşı takvalı olursa, Allah ona bir çıkış yolu ihsan eder ve onu ummadığı yerden rızıklandırır.\"\n(Talâk Suresi, 65/2-3)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, takvanın Allah katındaki değerini göstermektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Hadis",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamber Efendimiz (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Takva buradadır.\" (Göğsünü işaret ederek bunu üç defa söylemiştir.)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bir başka hadisinde ise:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Nerede olursan ol Allah'a karşı takvalı ol.\"",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "buyurmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva; Allah'ın emirlerine uymak ve yasaklarından sakınmaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva, Allah'a karşı sorumluluk bilinciyle yaşamaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva sahibi kişi güzel ahlaklı ve güvenilir olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an'a göre üstünlük; soyda, makamda veya zenginlikte değil, takvadadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav), takvanın en güzel örneğidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva, Allah'a karşı saygı ve sorumluluk bilinciyle yaşayarak O'nun emirlerini yerine getirmek ve yasaklarından kaçınmaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva sahibi kişi; dürüst, adaletli, merhametli ve güzel ahlaklı olmaya gayret eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'e göre insanların üstünlüğü, mal veya soyla değil, takva iledir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamber Efendimiz (sav), hayatıyla takvanın en güzel örneğini göstermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Takva, insanın Allah'a yakınlaşmasına, günahlardan uzak durmasına ve huzurlu bir hayat sürmesine yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
