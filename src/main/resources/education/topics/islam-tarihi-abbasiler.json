{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Abbasiler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Abbâsîler Kimdir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsîler, Emevî Devleti'nin yıkılmasının ardından 750 yılında kurulan ve 1258 yılına kadar İslam dünyasının büyük bölümünü yöneten hanedandır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Adını, Hz. Muhammed'in (sav) amcası Abbâs bin Abdülmuttalib'den almıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İlk halifesi Ebû'l-Abbas es-Seffâh'tır. Devletin başkenti ise daha sonra Bağdat olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsîler dönemi, İslam tarihinin ilim, kültür, sanat ve bilim alanında en parlak dönemlerinden biri olarak kabul edilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Abbâsî Devleti'nin Kuruluşu",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Emevî Devleti'nin zayıflaması üzerine başlayan isyanlar sonucunda Abbâsîler iktidara gelmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "750 yılında yapılan Büyük Zap Savaşı'nda Emevîler yenilmiş ve Abbâsî Devleti kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İlk halife Ebû'l-Abbas es-Seffâh olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Abbâsîlerin Özellikleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsîler döneminde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkent Bağdat olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bilim ve eğitime büyük önem verilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Farklı milletlerden insanlar devlet yönetiminde görev almıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret gelişmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam medeniyeti büyük ilerleme kaydetmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilim ve Kültürde Altın Çağ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsîler döneminde Bağdat, dünyanın en önemli ilim merkezlerinden biri hâline gelmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu dönemde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Matematik",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Astronomi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tıp",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kimya",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Felsefe",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Coğrafya",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "alanlarında önemli çalışmalar yapılmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Birçok eser Arapçaya çevrilmiş ve yeni bilimsel çalışmalar ortaya konmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Beytü'l-Hikme",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsî Halifesi Me'mûn döneminde Bağdat'ta Beytü'l-Hikme (Bilgelik Evi) kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Beytü'l-Hikme;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kütüphane,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Çeviri merkezi,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Araştırma merkezi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "olarak faaliyet göstermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Burada Yunan, Hint ve İran medeniyetlerine ait birçok eser Arapçaya çevrilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Türklerle İlişkiler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsîler döneminde Türklerle yakın ilişkiler kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Türkler devlet yönetiminde görev almıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Orduda önemli görevler üstlenmişlerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Zamanla İslamiyet Türkler arasında yayılmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu gelişmeler, Türk-İslam tarihinin başlangıcında önemli rol oynamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Abbâsî Devleti'nin Zayıflaması ve Yıkılışı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Zamanla;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İç karışıklıklar,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Taht mücadeleleri,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bazı eyaletlerin bağımsız hareket etmesi,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "devleti zayıflatmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1258 yılında Moğol Hükümdarı Hülagû Han, Bağdat'ı ele geçirerek Abbâsî Devleti'ne son vermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Abbâsîlerden Alınacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsîler dönemi bizlere önemli mesajlar verir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bilim ve eğitime önem vermek toplumları geliştirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Farklı kültürlerden faydalanmak medeniyetin ilerlemesini sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Adalet ve birlik güçlü devletlerin temelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İlim öğrenmek ve öğretmek İslam'ın önemli değerlerindendir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tarihteki medeniyetler insanlığa önemli katkılar sunmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Hiç bilenlerle bilmeyenler bir olur mu?\"\n(Zümer Suresi, 39/9)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Rabbim! İlmimi artır.\"\n(Tâhâ Suresi, 20/114)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, ilim öğrenmenin ve bilgiye değer vermenin önemini göstermektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsî Devleti 750-1258 yılları arasında hüküm sürmüştür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İlk halifesi Ebû'l-Abbas es-Seffâh'tır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkenti Bağdat'tır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Beytü'l-Hikme, bu dönemin önemli ilim merkezidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsîler döneminde bilim, kültür ve sanat büyük gelişme göstermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devlet, 1258 yılında Hülagû Han'ın Bağdat'ı işgal etmesiyle sona ermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsîler, Emevî Devleti'nin ardından kurulan ve 750-1258 yılları arasında hüküm süren İslam devletidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkentleri Bağdat olmuş ve şehir, dönemin en önemli bilim ve kültür merkezlerinden biri hâline gelmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Beytü'l-Hikme sayesinde birçok eser çevrilmiş, matematik, tıp, astronomi ve diğer bilimlerde önemli gelişmeler yaşanmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsîler döneminde Türklerle yakın ilişkiler kurulmuş ve Türkler devlet yönetimi ile orduda önemli görevler üstlenmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İç karışıklıklar ve Moğol saldırıları sonucunda 1258 yılında Abbâsî Devleti yıkılmıştır.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
