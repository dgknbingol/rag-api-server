{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Kelime Okuma",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kelime Okuma Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelime okuma, öğrenilen harfleri, harekeleri ve heceleri bir araya getirerek Arapça kelimeleri doğru şekilde okuyabilme becerisidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'i akıcı okuyabilmek için önce kelimeleri doğru okumayı öğrenmek gerekir. Kelime okuma, hece okumadan sonra gelen en önemli aşamalardan biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu aşamada amaç, harfleri tek tek okumak yerine kelimeyi bir bütün olarak okuyabilmektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kelimeler Nasıl Oluşur?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Arapçada kelimeler, harflerin ve harekelerin belirli bir düzen içinde birleşmesiyle oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her harf, aldığı harekeye göre farklı okunur ve bütün harfler birleştiğinde kelime meydana gelir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örneğin:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "كَتَبَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "خَلَقَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "عَلِمَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "دَخَلَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu kelimeler, harflerin doğru şekilde birleştirilmesiyle okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kelime Okurken Nelere Dikkat Edilmelidir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelime okunurken;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin mahrecine dikkat edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harekeler doğru takip edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şedde ve cezm gibi işaretler doğru uygulanmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ses gereğinden fazla uzatılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelime bölünmeden, akıcı şekilde okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Amaç hızlı okumak değil, doğru okumaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Basit Kelime Çalışmaları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Aşağıdaki kelimeleri sesli olarak okuyunuz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "كَتَبَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "دَخَلَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "خَرَجَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "عَلِمَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "فَتَحَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her kelimeyi birkaç kez tekrar ederek okumaya çalışınız.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Farklı Harekelerle Kelime Okuma",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelimelerde üstün, esre ve ötre birlikte bulunabilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "كُتِبَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "رُسُلٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "مُسْلِمٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "مَسْجِدٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her harekenin verdiği sesi doğru uygulayarak okuyunuz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Şeddeli Kelimeler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şeddeli harf bulunan kelimelerde harf kısa süre tutulur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "رَبَّ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ثُمَّ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "إِنَّ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "حَقٌّ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şeddeyi atlamadan okumaya dikkat ediniz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cezmli Kelimeler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cezm bulunan kelimelerde cezmli harf, önceki harekeli harfle birlikte okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "يَكْتُبُ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "يَدْخُلُ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "اِسْمٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "أَبْصَرَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cezmli harfe yeni bir hareke verilmez.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Yavaş ve Dikkatli Okuma",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelime okumaya yeni başlayanlar için yavaş okumak daha doğrudur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Önce doğruluk kazanılmalı, ardından zamanla akıcılık geliştirilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yanlışları düzeltmeden hızlı okumaya çalışmak doğru bir yöntem değildir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Düzenli Tekrarın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelime okumada gelişmenin en etkili yolu düzenli tekrar yapmaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her gün kısa süre yapılan çalışmalar sayesinde harfler, heceler ve kelimeler daha hızlı tanınmaya başlanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar, Kur'an okumada güven ve akıcılık kazandırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an ve Hadislerde Kur'an'ı Doğru Okumanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı tane tane, ağır ağır oku.\"\n(Müzzemmil Suresi, 73/4)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı öğrenen ve onu okuyan kimseye büyük ecir vardır. Okurken zorlanan kimseye ise iki ecir vardır.\" (Müslim)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelimeler, harflerin ve harekelerin birleşmesiyle oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelime okunurken harfler tek tek değil, bir bütün olarak okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harekeler, cezm ve şedde doğru uygulanmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru telaffuz için mahreçlere dikkat edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar yapmak, kelime okumayı geliştirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelime okuma, harf ve heceleri birleştirerek Arapça kelimeleri doğru okumayı öğrenme aşamasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelime okunurken harfler, harekeler ve diğer okuma işaretleri birlikte değerlendirilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şeddeli ve cezmli kelimeler daha önce öğrenilen kurallara uygun şekilde okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Öncelikle doğru okumaya odaklanılmalı, akıcılık ise zamanla kazanılmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar, Kur'an-ı Kerim'i doğru ve akıcı okuyabilmenin temelidir.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
