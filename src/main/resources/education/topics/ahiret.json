{
  "readingMinutes": 3,
  "blocks": [
    {
      "type": "heading",
      "text": "Ahiret",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ahiret Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahiret, dünya hayatının sona ermesinden sonra başlayacak olan ebedî (sonsuz) hayattır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam inancına göre insanlar bu dünyada yaptıkları bütün davranışlardan sorumlu tutulacak, öldükten sonra Allah tarafından yeniden diriltilecek ve hesaba çekilecektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahirete iman, imanın altı şartından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ahirete İmanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahirete inanmak, Müslümanın hayatını bilinçli ve sorumlu bir şekilde yaşamasını sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahirete iman sayesinde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İnsan yaptığı her davranışın hesabını vereceğini bilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İyilik yapmaya teşvik edilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günahlardan kaçınmaya çalışır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sabır ve umut kazanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dünya hayatının geçici olduğunu unutmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ahiret Hayatının Aşamaları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam'a göre ahiret hayatı belirli aşamalardan oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ölüm",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dünya hayatının sona ermesidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her insan ölümü tadacaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Berzah Âlemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ölüm ile kıyamet arasında geçen dönemdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İnsan bu dönemde kıyametin kopmasını bekler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kıyamet",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın emriyle evrendeki düzen sona erecek ve dünya hayatı bitecektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kıyametin ne zaman kopacağını yalnızca Allah bilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Yeniden Diriliş (Ba's)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kıyametten sonra bütün insanlar Allah tarafından yeniden diriltilecektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Mahşer",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bütün insanların bir araya toplanacağı yerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Burada herkes hesap vermek üzere toplanacaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Hesap ve Mizan",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İnsanların dünyada yaptıkları iyilik ve kötülüklerin hesabı görülecek, amelleri değerlendirilecektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cennet ve Cehennem",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hesabın sonunda;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın rızasını kazanan müminler cennete,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın adaleti gereği cezayı hak edenler ise cehenneme gönderilecektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ahirete İmanın Günlük Hayata Etkileri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahirete iman eden Müslüman;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kul hakkına dikkat eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru ve dürüst davranır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İbadetlerine önem verir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sabırlı ve merhametli olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dünyanın geçici olduğunu bilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ahiretten Alınacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahiret inancı bizlere önemli mesajlar verir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dünya hayatı geçicidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her insan yaptıklarından sorumludur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah mutlak adalet sahibidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İyilik yapan karşılığını görecektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslüman ahiret için de hazırlık yapmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Her nefis ölümü tadacaktır. Sonra bize döndürüleceksiniz.\"\n(Ankebût Suresi, 29/57)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kim zerre kadar hayır işlerse onu görür. Kim de zerre kadar kötülük işlerse onu görür.\"\n(Zilzâl Suresi, 99/7-8)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, ölümün kaçınılmaz olduğunu ve herkesin yaptıklarının karşılığını göreceğini bildirmektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahiret, ölümden sonra başlayacak sonsuz hayattır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahirete iman, imanın altı şartından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahiret hayatının aşamaları; ölüm, berzah, kıyamet, yeniden diriliş, mahşer, hesap, mizan, cennet ve cehennemdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dünya hayatı bir imtihan yeridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her insan yaptıklarının hesabını Allah'a verecektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahiret, dünya hayatından sonra başlayacak sonsuz hayattır ve ahirete iman, İslam'ın temel iman esaslarındandır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ölümden sonra insanlar berzah âlemine geçecek, kıyametin ardından yeniden diriltilecek ve mahşerde toplanacaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Herkes dünyada yaptığı iyilik ve kötülüklerden hesaba çekilecek, ardından Allah'ın adaletiyle cennet veya cehennemle karşılaşacaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ahiret inancı, insanı dürüstlüğe, ibadete, kul hakkına riayet etmeye ve güzel ahlaka yöneltir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dünya hayatı geçici, ahiret hayatı ise ebedîdir.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
