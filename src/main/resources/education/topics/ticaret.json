{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Ticaret",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ticaret Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret, insanların ihtiyaçlarını karşılamak amacıyla mal ve hizmetlerin alınıp satılması faaliyetidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam dini, helal yollarla yapılan dürüst ticareti teşvik etmiş, haksız kazancı, aldatmayı ve kul hakkını ise yasaklamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav), peygamberlikten önce de ticaretle uğraşmış ve dürüstlüğü sayesinde \"el-Emîn (Güvenilir)\" unvanını almıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ticaretin Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret, insanların ihtiyaçlarını karşılamasına ve toplumun ekonomik hayatının gelişmesine katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam'a göre ticaret;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal kazanç elde etmeyi sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Çalışmayı ve üretmeyi teşvik eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Toplumun ihtiyaçlarının karşılanmasına katkıda bulunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dürüstlük ve güveni güçlendirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ekonomik hayatın düzenli işlemesine yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İslam'da Ticaretin Temel İlkeleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam'da ticaret şu temel ilkeler üzerine kuruludur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Dürüstlük",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Alıcı ve satıcı birbirine karşı doğru sözlü olmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Malın kusuru gizlenmemeli, alıcı aldatılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Helal Kazanç",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kazanç meşru yollarla elde edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hırsızlık, rüşvet, faiz, dolandırıcılık ve hile ile elde edilen kazanç haramdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Karşılıklı Rıza",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Alışverişte hem alıcının hem de satıcının gönül rızası bulunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Zorlama ile yapılan alışveriş dinen uygun değildir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ölçü ve Tartıda Adalet",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Alım satımda eksik tartmak veya ölçüde hile yapmak yasaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim, ölçü ve tartıda dürüst olmayı emreder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Yasaklanan Ticari Davranışlar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam'da aşağıdaki davranışlar yasaklanmıştır:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Faiz almak ve vermek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hileli satış yapmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eksik tartmak ve ölçmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Malın kusurunu gizlemek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Rüşvet almak veya vermek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Karaborsacılık ve stokçulukla insanları zor durumda bırakmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dolandırıcılık yapmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu yasaklar hem bireyin hem de toplumun haklarını korumayı amaçlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Peygamberimizin Ticaret Ahlakı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav);",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dürüst davranırdı.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Verdiği sözü yerine getirirdi.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kimseyi aldatmazdı.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Emanete ihanet etmezdi.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ölçü ve tartıda adaletli davranırdı.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu güzel ahlakı sayesinde insanlar ona büyük güven duymuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ticaretin Faydaları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal ticaret;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Toplumda güven oluşturur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ekonomiyi güçlendirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İnsanların ihtiyaçlarını karşılar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal kazanç sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın rızasını kazanmaya vesile olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ticaretten Alınacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret bizlere önemli mesajlar verir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dürüstlük her zaman kazandırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal kazanç en değerli kazançtır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kul hakkına dikkat edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ölçü ve tartıda adaletli olunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Güvenilir olmak başarılı ticaretin temelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Ey iman edenler! Mallarınızı aranızda haksız yollarla yemeyin. Ancak karşılıklı rızaya dayanan ticaret bunun dışındadır.\"\n(Nisâ Suresi, 4/29)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Ölçüyü tam yapın, eksik ölçenlerden olmayın.\"\n(Şuarâ Suresi, 26/181)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, ticarette dürüstlük, adalet ve karşılıklı rızanın önemini göstermektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret, mal ve hizmetlerin alınıp satılmasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam, helal ve dürüst ticareti teşvik eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticarette dürüstlük, güven ve karşılıklı rıza esastır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Faiz, hile, rüşvet ve dolandırıcılık dinen yasaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav), güvenilir bir tüccar olarak örnek olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret, insanların ihtiyaçlarını karşılamak amacıyla yapılan mal ve hizmet alışverişidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam dini, helal kazancı ve dürüst ticareti teşvik etmiş; faiz, hile, rüşvet ve aldatmayı yasaklamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticarette dürüstlük, güven, karşılıklı rıza ve ölçü-tartıda adalet temel ilkelerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamber Efendimiz (sav), ticaret hayatında doğruluğu ve güvenilirliğiyle örnek olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal ticaret, hem bireyin kazancını bereketlendirir hem de toplumda güven ve adaletin oluşmasına katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
