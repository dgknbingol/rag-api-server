{
  "readingMinutes": 3,
  "blocks": [
    {
      "type": "heading",
      "text": "İklab",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İklab Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab, tecvid kurallarından biridir ve cezmli nûn (نْ) veya tenvinden sonra \"ب\" (Be) harfi geldiğinde, nûn sesinin \"m\" sesine dönüştürülerek okunmasına denir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"İklab\" kelimesi Arapçada \"dönüştürmek, çevirmek\" anlamına gelir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab uygulanırken nûn sesi doğrudan okunmaz; onun yerine hafif bir m sesi ve geniz sesi (gunne) ile okuma yapılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İklab Neden Yapılır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'in doğru okunmasını sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn ile be harfinin telaffuzunu kolaylaştırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okumaya akıcılık ve güzellik kazandırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed'in (sav) öğrettiği okuyuşa uygun okumaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İklab Hangi Durumlarda Yapılır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab yalnızca tek bir durumda uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cezmli nûn (نْ) veya tenvinden sonra \"ب\" (Be) harfi geldiğinde iklab yapılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka hiçbir harfte iklab uygulanmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İklab Nasıl Okunur?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab uygulanırken;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi \"m\" sesine dönüşür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yaklaşık iki hareke miktarı gunne (geniz sesi) yapılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Daha sonra be (ب) harfi okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okuyuş sırasında dudaklar kapanır ve ses doğal bir şekilde be harfine geçer.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İklab Örnekleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cezmli Nûn",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "أَنْبِئْهُمْ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "مِنْ بَعْدِ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "أَنْبَتَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu örneklerde cezmli nûndan sonra ب harfi geldiği için iklab uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Tenvin",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "سَمِيعٌ بَصِيرٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "عَلِيمًا بِذَاتِ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "غَفُورٌ بِمَا",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu örneklerde tenvinden sonra ب harfi geldiği için iklab yapılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İklab Okurken Nelere Dikkat Edilmelidir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi m sesine dönüştürülmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yaklaşık iki hareke miktarı gunne yapılmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dudaklar be harfi için doğal şekilde kapanmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi açık şekilde okunmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Geniz sesi gereğinden fazla uzatılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İhfa, İdğam ve İklab Arasındaki Fark",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu üç kural birbirine benzeyebilir; ancak farklı uygulanırlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İhfa: Nûn sesi tamamen kaybolmaz, genizden hafifçe okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam: Nûn sesi kendisinden sonraki harfe katılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab: Nûn sesi m sesine dönüşür ve ardından ب harfi okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her kuralın uygulanacağı harfler farklıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Sık Yapılan Hatalar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesini m sesine çevirmemek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gunne yapmamak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gunneyi gereğinden fazla uzatmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklabı ihfa veya idğam gibi okumak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru iklabda nûn sesi m sesine dönüşür ve iki hareke miktarı gunne ile okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an ve Hadislerde Kur'an'ı Güzel Okumanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı tane tane, ağır ağır oku.\"\n(Müzzemmil Suresi, 73/4)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı seslerinizle güzelleştiriniz.\" (Ebû Dâvûd, Vitir)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab, cezmli nûn veya tenvinden sonra ب harfi geldiğinde uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab kelimesi \"dönüştürmek\" anlamına gelir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi m sesine dönüşür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yaklaşık iki hareke miktarı gunne yapılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab yalnızca ب harfi ile uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab, cezmli nûn veya tenvinden sonra ب harfi geldiğinde uygulanan bir tecvid kuralıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu kuralda nûn sesi m sesine dönüştürülerek okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab uygulanırken yaklaşık iki hareke miktarı gunne yapılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab yalnızca ب harfi ile uygulanır; başka harflerde uygulanmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab kuralını doğru uygulamak, Kur'an-ı Kerim'i daha doğru ve usulüne uygun okumaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
