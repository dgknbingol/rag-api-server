{
  "readingMinutes": 3,
  "blocks": [
    {
      "type": "heading",
      "text": "Hece Okuma",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Hece Okuma Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hece okuma, Arap harflerini ve harekeleri bir araya getirerek heceler oluşturup doğru şekilde okumayı öğrenme aşamasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'i akıcı okuyabilmek için önce heceleri doğru okumayı öğrenmek gerekir. Harfleri tek tek tanımak önemli olsa da, onları birleştirerek hece hâlinde okuyabilmek Kur'an okumaya geçişin temel basamaklarından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Hece Nasıl Oluşur?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hece, bir veya daha fazla harfin birleşmesiyle oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Arapçada en temel hece yapısı, harekeli bir harf ile ardından gelen bir harften oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örneğin:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "بَ = Be",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "بِ = Bi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "بُ = Bu",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu sesler, daha uzun kelimelerin temel yapı taşlarını oluşturur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İki Harfli Heceler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İki harften oluşan hecelerle başlanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "بَتَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "تَبَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "مَنَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "لَبَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "نَزَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu örneklerde harfler tek tek değil, birlikte okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Üç Harfli Heceler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İki harfli heceler kolaylaştıktan sonra üç harfli yapılar okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "كَتَبَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "دَخَلَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "عَلِمَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "خَلَقَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "فَتَحَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu tür çalışmalar, kelime okumaya hazırlık sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Farklı Harekelerle Hece Okuma",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Heceler yalnızca üstün ile değil, esre ve ötre ile de okunabilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Üstün",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "بَ تَ مَ نَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Esre",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "بِ تِ مِ نِ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ötre",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "بُ تُ مُ نُ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her hareke, hecenin okunuşunu değiştirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cezmli Heceler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cezm bulunan heceler, önceki harekeli harfle birlikte okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "أَبْ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "اِتْ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "اُمْ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "اَنْ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cezmli harf ayrı okunmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Şeddeli Heceler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şeddeli harfler okunurken harf kısa süre tutulur ve ardından harekesiyle birlikte okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "رَبَّ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "إِنَّ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ثُمَّ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "عَمَّ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şedde, hecenin daha belirgin okunmasını sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Hece Okurken Nelere Dikkat Edilmelidir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin mahrecine dikkat edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harekeler doğru takip edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sesler gereğinden fazla uzatılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Heceler bölünmeden okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Acele edilmeden, tane tane çalışılmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru okuma alışkanlığı, yavaş ve dikkatli çalışmayla kazanılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Düzenli Tekrarın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hece okumada başarılı olmanın en etkili yolu düzenli tekrar yapmaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İlk zamanlarda okumak yavaş olabilir. Ancak her gün yapılan kısa çalışmalar sayesinde heceler daha hızlı tanınır ve okumak kolaylaşır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sabırlı olmak ve düzenli çalışmak, Kur'an okumayı öğrenmede büyük önem taşır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an ve Hadislerde Kur'an'ı Doğru Okumanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı tane tane, ağır ağır oku.\"\n(Müzzemmil Suresi, 73/4)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı öğrenen ve onu okuyan kimseye büyük ecir vardır. Okurken zorlanan kimseye ise iki ecir vardır.\" (Müslim)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu hadis, Kur'an okumayı öğrenirken sabır ve gayret göstermenin değerini ortaya koymaktadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hece okuma, harfleri birleştirerek doğru şekilde okumayı öğrenme aşamasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Heceler, harfler ve harekelerin birleşmesiyle oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Üstün, esre ve ötre hecelerin okunuşunu değiştirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cezmli ve şeddeli heceler daha önce öğrenilen kurallara göre okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar yapmak, akıcı okumayı geliştirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hece okuma, Kur'an okumaya geçmeden önce öğrenilmesi gereken önemli bir adımdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Heceler, harflerin ve harekelerin birleşmesiyle oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Üstün, esre ve ötre hecelerin sesini belirler; cezm ve şedde ise okunuş şeklini etkiler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Heceler okunurken mahreçlere dikkat edilmeli ve sesler gereğinden fazla uzatılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar ve sabırlı çalışma, hece okumayı kolaylaştırır ve kelime okumaya hazırlık sağlar.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
