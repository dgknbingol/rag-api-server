{
  "readingMinutes": 5,
  "blocks": [
    {
      "type": "heading",
      "text": "Büyük Selçuklu",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Büyük Selçuklu Devleti Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklu Devleti, 1040 yılında kurulmuş ve Türklerin İslam dünyasında büyük bir güç hâline gelmesini sağlayan önemli bir Türk-İslam devletidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devlet, Selçuk Bey'in torunları Tuğrul Bey ve Çağrı Bey tarafından kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkenti ilk yıllarda Nişâbur, daha sonra Rey ve İsfahan olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklular, İslam dünyasının siyasi birliğini büyük ölçüde sağlamış, bilim ve eğitimin gelişmesine önemli katkılar sunmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Büyük Selçuklu Devleti'nin Kuruluşu",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Selçuklular, Oğuz Türklerinin Kınık Boyu'na mensuptur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1040 yılında Dandanakan Savaşı'nda Gaznelileri yenerek bağımsızlıklarını ilan etmiş ve Büyük Selçuklu Devleti'ni kurmuşlardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İlk hükümdar Tuğrul Bey olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Önemli Hükümdarlar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Tuğrul Bey (1040–1063)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devletin kurucusudur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Abbâsî Halifesi tarafından \"Doğu ve Batı'nın Sultanı\" unvanı verilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bağdat'a girerek halifeyi koruma altına almıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devletin temellerini sağlamlaştırmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Alp Arslan (1063–1072)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklu Devleti'nin en önemli hükümdarlarındandır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "En önemli başarısı:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1071 Malazgirt Savaşı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu savaşta Bizans İmparatoru IV. Romanos Diogenes'i yenmiş ve Anadolu'nun kapılarını Türklere açmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Melikşah (1072–1092)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklu Devleti'nin en güçlü dönemini yaşatan hükümdardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Onun döneminde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devlet en geniş sınırlarına ulaşmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bilim ve eğitim gelişmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nizamiye Medreseleri yaygınlaşmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret yolları güven altına alınmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Nizâmülmülk",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Melikşah'ın ünlü veziridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam tarihinin en önemli devlet adamlarından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başlıca hizmetleri:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nizamiye Medreseleri'ni kurmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devlet yönetimini güçlendirmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Siyasetnâme adlı önemli eserini yazmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Nizamiye Medreseleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nizamiye Medreseleri, Büyük Selçuklular döneminde kurulan yüksek eğitim kurumlarıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu medreselerde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tefsir",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hadis",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Fıkıh",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelâm",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Matematik",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Astronomi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "gibi dersler okutulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu kurumlar, İslam dünyasında üniversite anlayışının gelişmesine önemli katkı sağlamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Malazgirt Savaşı (1071)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "26 Ağustos 1071 tarihinde gerçekleşmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Taraflar:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklu Devleti (Alp Arslan)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bizans İmparatorluğu",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sonuçları:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu'nun kapıları Türklere açıldı.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Türklerin Anadolu'ya yerleşmesi hızlandı.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Türkiye tarihinin dönüm noktalarından biri oldu.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu'da Türk-İslam medeniyetinin temelleri atıldı.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Büyük Selçuklu Devleti'nin Yıkılışı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Melikşah'ın vefatından sonra;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Taht mücadeleleri,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İç karışıklıklar,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Haçlı Seferleri,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Atabeyliklerin güçlenmesi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "devleti zayıflatmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1157 yılında Sultan Sencer'in vefatıyla Büyük Selçuklu Devleti sona ermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Büyük Selçuklulardan Alınacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklu Devleti bizlere önemli mesajlar verir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Birlik ve beraberlik güçlü devletlerin temelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğitim ve ilim toplumun gelişmesini sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Adaletli yönetim devletleri güçlendirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Malazgirt Zaferi, Anadolu'nun Türkleşmesinde önemli bir dönüm noktasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bilim ve eğitime yatırım, medeniyetin gelişmesini sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Hiç bilenlerle bilmeyenler bir olur mu?\"\n(Zümer Suresi, 39/9)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Allah, sizden iman edenleri ve kendilerine ilim verilenleri derecelerle yükseltir.\"\n(Mücâdele Suresi, 58/11)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, ilmin ve eğitimin önemini vurgulamaktadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklu Devleti 1040-1157 yılları arasında hüküm sürmüştür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kurucuları Tuğrul Bey ve Çağrı Bey'dir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devletin en önemli hükümdarları Tuğrul Bey, Alp Arslan ve Melikşah'tır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1071 Malazgirt Savaşı, Anadolu'nun Türklere açılmasını sağlamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nizâmülmülk, Nizamiye Medreseleri'ni kurmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklular, bilim ve eğitime büyük önem vermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklu Devleti, 1040 yılında Dandanakan Savaşı'ndan sonra kurulmuş önemli bir Türk-İslam devletidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tuğrul Bey devleti kurmuş, Alp Arslan Malazgirt Zaferi ile Anadolu'nun kapılarını Türklere açmış, Melikşah ise devleti en parlak dönemine ulaştırmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nizâmülmülk tarafından kurulan Nizamiye Medreseleri, İslam dünyasında eğitim ve bilimin gelişmesine büyük katkı sağlamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük Selçuklular, İslam dünyasında siyasi birliği güçlendirmiş ve Anadolu'nun Türkleşme sürecinde önemli rol oynamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İç karışıklıklar ve dış tehditler sonucunda devlet 1157 yılında sona ermiştir.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
