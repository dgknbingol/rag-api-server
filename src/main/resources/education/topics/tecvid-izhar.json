{
  "readingMinutes": 3,
  "blocks": [
    {
      "type": "heading",
      "text": "İzhar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İzhar Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar, tecvid kurallarından biridir ve cezmli nûn (نْ) veya tenvinden sonra boğaz harflerinden biri geldiğinde, nûn sesinin açık ve belirgin bir şekilde okunmasına denir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"İzhar\" kelimesi Arapçada \"açığa çıkarmak, açıkça söylemek\" anlamına gelir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar uygulanırken nûn sesi gizlenmez, başka bir harfe dönüştürülmez ve sonraki harfe katılmaz. Harf, mahrecinden açık ve net bir şekilde okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İzhar Neden Yapılır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'in doğru okunmasını sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin mahreçlerini korur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesinin açık ve belirgin şekilde duyulmasına yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an tilavetinin doğru ve anlaşılır olmasını sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İzhar Hangi Durumlarda Yapılır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar, cezmli nûn (نْ) veya tenvinden sonra, aşağıdaki altı boğaz harfinden biri geldiğinde uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar harfleri şunlardır:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ء، هـ، ع، ح، غ، خ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu harfler boğaz harfleri olarak da bilinir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İzhar Nasıl Okunur?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar uygulanırken;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi açık ve net okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Geniz sesi (gunne) yapılmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi başka bir harfe dönüşmez.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sonraki harfe doğal bir şekilde geçilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzharın temel özelliği, nûn sesinin açıkça duyulmasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İzhar Örnekleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cezmli Nûn",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "مِنْهُمْ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "أَنْعَمْتَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "يَنْهَوْنَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu örneklerde cezmli nûndan sonra izhar harflerinden biri geldiği için nûn sesi açık şekilde okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Tenvin",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "عَلِيمٌ حَكِيمٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "غَفُورٌ خَبِيرٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "سَمِيعٌ عَلِيمٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu örneklerde tenvinden sonra izhar harflerinden biri geldiği için nûn sesi açık şekilde okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İzhar Okurken Nelere Dikkat Edilmelidir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi açık ve belirgin okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Geniz sesi (gunne) yapılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi başka bir harfe dönüştürülmemelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin mahreçleri korunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sonraki harfe yumuşak ve doğal geçiş yapılmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İzhar, İhfa, İdğam ve İklab Arasındaki Fark",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu dört tecvid kuralı birbirinden farklıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar: Nûn sesi açık ve belirgin okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İhfa: Nûn sesi genizden hafifçe okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İdğam: Nûn sesi sonraki harfe katılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İklab: Nûn sesi m sesine dönüşür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her kuralın uygulanacağı harfler farklıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Sık Yapılan Hatalar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar yapılması gereken yerde ihfa yapmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesini gizlemek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gereksiz yere geniz sesi kullanmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesini sonraki harfe katmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru izharda nûn sesi açık ve net şekilde duyulmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an ve Hadislerde Kur'an'ı Güzel Okumanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı tane tane, ağır ağır oku.\"\n(Müzzemmil Suresi, 73/4)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı seslerinizle güzelleştiriniz.\" (Ebû Dâvûd, Vitir)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar, cezmli nûn veya tenvinden sonra boğaz harflerinden biri geldiğinde uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar harfleri altıdır: ء، هـ، ع، ح، غ، خ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nûn sesi açık ve belirgin okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar uygulanırken gunne yapılmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru izhar, Kur'an'ın usulüne uygun okunmasına katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar, cezmli nûn veya tenvinden sonra boğaz harfleri geldiğinde uygulanan bir tecvid kuralıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu kuralda nûn sesi açık ve belirgin şekilde okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar harfleri ء، هـ، ع، ح، غ، خ olmak üzere altı tanedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar uygulanırken nûn sesi gizlenmez, başka bir harfe dönüştürülmez ve geniz sesi kullanılmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İzhar kuralını doğru uygulamak, Kur'an-ı Kerim'i doğru ve güzel okumaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
