{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Gıybet",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Gıybet Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet, bir kimsenin arkasından, o kişi duyduğu takdirde hoşlanmayacağı doğru bir şeyi söylemektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğer söylenen şey doğru değilse bu iftira olur ve gıybetten daha büyük bir günahtır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam ahlakında gıybet, insanlar arasındaki sevgi ve güveni zedeleyen kötü davranışlardan biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İslam'da Gıybetin Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam dini, insanların onurunu ve saygınlığını korumaya büyük önem verir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu nedenle Müslüman;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkalarının kusurlarını araştırmamalı,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Arkalarından kötü konuşmamalı,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dedikodu yapmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet, kardeşlik duygusunu zayıflatır ve toplumda huzursuzluğa sebep olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Gıybet ile İftira Arasındaki Fark",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Gıybet",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bir kişinin arkasından, hoşuna gitmeyecek doğru bir şeyi söylemektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnek:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Ahmet çok sinirli biridir.\"",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğer Ahmet gerçekten öyleyse bu gıybettir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İftira",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bir kişi hakkında doğru olmayan bir suçlama veya söz söylemektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnek:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yapmadığı bir şeyi yapmış gibi göstermek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İftira, hem kul hakkı hem de büyük bir günahtır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Gıybetin Zararları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İnsanlar arasındaki güveni bozar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dostlukları zedeler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kin ve düşmanlığa yol açar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kul hakkına girilmesine neden olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Toplumun huzurunu bozar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Gıybetten Nasıl Kaçınılır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkalarının kusurlarını konuşmamak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Faydasız sohbetlerden uzak durmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkası gıybet ettiğinde konuyu değiştirmek veya uygun bir dille uyarmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İnsanların güzel yönlerini anlatmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kendi eksiklerini düzeltmeye çalışmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Gıybet Edildiğinde Ne Yapılmalıdır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eğer bir kişi gıybet ettiğini fark ederse;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'tan samimiyetle tevbe etmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Aynı davranışı tekrar etmemeye karar vermelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet ettiği kişiden imkân varsa helallik istemelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Onun hakkında hayırla konuşmaya gayret etmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Günlük Hayatta Gıybete Örnekler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bir arkadaşın arkasından kusurlarını anlatmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İş arkadaşını başkalarına kötülemek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Komşunun özel hayatını konuşmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sosyal medyada birini küçümseyici yorumlar yapmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Birinin fiziksel özellikleriyle alay etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Birbirinizin gıybetini yapmayın. Sizden biriniz, ölmüş kardeşinin etini yemekten hoşlanır mı? İşte bundan tiksindiniz.\"\n(Hucurât Suresi, 49/12)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Ey iman edenler! Zannın çoğundan sakının...\"\n(Hucurât Suresi, 49/12)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, gıybetten ve kötü zan beslemekten sakınmayı emretmektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Hadis",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamber Efendimiz (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Gıybet nedir bilir misiniz?\"",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sahabiler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Allah ve Resûlü daha iyi bilir.\"",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "dediler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamberimiz buyurdu:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kardeşini hoşlanmayacağı şekilde anmandır.\"",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sahabiler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Söylediğimiz şey onda varsa?\"",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "deyince şöyle buyurdu:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Eğer söylediğin onda varsa gıybet etmiş olursun; yoksa iftira etmiş olursun.\"",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Gıybet İstisnaları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Normal şartlarda gıybet haramdır. Ancak İslam âlimleri bazı zorunlu durumlarda, haksızlığı önlemek veya bir hakkı korumak amacıyla, gerekli olduğu kadar bilgi verilmesini caiz görmüştür. Bunlara örnek olarak:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bir haksızlığı yetkili makamlara bildirmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Mahkemede şahitlik yapmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bir kişinin zarar görmesini önlemek için gerekli uyarıyı yapmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dini konuda fetva almak amacıyla durumu anlatmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu durumlarda bile amaç kötülemek değil, hakkı ortaya çıkarmak olmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet, bir kişinin arkasından hoşlanmayacağı doğru bir şeyi söylemektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru olmayan bir şeyi söylemek ise iftiradır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet, Kur'an ve sünnette yasaklanmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet kul hakkına girer ve toplumdaki güveni zedeler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet eden kişi tevbe etmeli ve mümkünse hak sahibinden helallik istemelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet, bir kişinin arkasından hoşlanmayacağı doğru bir sözü söylemektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam, insanların onurunu korumaya büyük önem verdiği için gıybeti yasaklamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet ile iftira farklıdır; iftira, doğru olmayan bir suçlama yapmaktır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet, insanlar arasındaki güveni ve kardeşliği bozar, kul hakkına girilmesine sebep olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslüman, başkalarının kusurlarını araştırmamalı, gıybetten kaçınmalı ve diliyle kimseye zarar vermemelidir.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
