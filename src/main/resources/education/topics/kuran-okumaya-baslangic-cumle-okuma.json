{
  "readingMinutes": 3,
  "blocks": [
    {
      "type": "heading",
      "text": "Cümle Okuma",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cümle Okuma Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cümle okuma, öğrenilen harfleri, harekeleri ve kelimeleri bir araya getirerek Arapça cümleleri doğru ve akıcı şekilde okuyabilme becerisidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim ayetlerden oluşur ve ayetler de kelimelerin bir araya gelmesiyle meydana gelir. Bu nedenle cümle okuma, ayet okumaya geçmeden önce öğrenilmesi gereken önemli bir aşamadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu aşamada amaç, kelimeleri tek tek okumak yerine cümleyi anlamlı ve akıcı bir bütün olarak okuyabilmektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cümleler Nasıl Oluşur?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Arapçada cümleler, belirli kurallara göre sıralanmış kelimelerden oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cümleyi doğru okuyabilmek için;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harfler doğru okunmalı,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harekeler doğru uygulanmalı,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelimeler doğru birleştirilmeli,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okuma akıcı olmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu temel kurallar, Kur'an okumada da aynı şekilde uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cümle Okurken Nelere Dikkat Edilmelidir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cümle okunurken;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin mahrecine dikkat edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harekeler doğru uygulanmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şedde, cezm ve tenvin gibi işaretler doğru okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelimeler birbirinden koparılmadan okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gereksiz duraklama yapılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okuma aceleye getirilmemelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru okuma, hızlı okumaktan daha önemlidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Basit Cümle Çalışmaları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Aşağıdaki örnekleri sesli olarak okuyunuz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "هَذَا كِتَابٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "اللَّهُ غَفُورٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "اللَّهُ رَحِيمٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "هُوَ رَبُّنَا",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "هَذَا مُسْلِمٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu cümleleri birkaç kez tekrar ederek akıcı okumaya çalışınız.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Şeddeli ve Cezmli Cümleler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şeddeli ve cezmli kelimeler bulunan cümlelerde daha önce öğrenilen kurallar uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnekler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "إِنَّ اللَّهَ غَفُورٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "رَبُّنَا اللَّهُ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "يَكْتُبُ الطَّالِبُ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu örneklerde şedde, cezm ve harekeler dikkatle okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Akıcı Okuma",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cümle okunurken kelimeler arasında doğal bir akış oluşturulmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ancak bu akıcılık, harfleri veya harekeleri eksik okumak anlamına gelmez.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Önce doğruluk kazanılmalı, zamanla akıcılık geliştirilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Düzenli Tekrarın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cümle okumayı geliştirmek için düzenli tekrar yapmak gerekir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her gün yapılan kısa çalışmalar;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelimeleri daha hızlı tanımayı,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru telaffuzu geliştirmeyi,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Akıcı okumayı kolaylaştırmayı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sabırlı ve düzenli çalışma, Kur'an okumada başarıyı artırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an ve Hadislerde Kur'an'ı Doğru Okumanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı tane tane, ağır ağır oku.\"\n(Müzzemmil Suresi, 73/4)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı öğrenen ve onu okuyan kimseye büyük ecir vardır. Okurken zorlanan kimseye ise iki ecir vardır.\" (Müslim)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu hadis, Kur'an okumayı öğrenirken gösterilen gayretin de değerli olduğunu bildirmektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cümleler, kelimelerin bir araya gelmesiyle oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cümle okunurken harfler, harekeler ve okuma işaretleri doğru uygulanmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelimeler birbirinden koparılmadan doğal bir akış içinde okunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şedde, cezm ve tenvin kuralları cümle içinde de geçerlidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar yapmak, akıcı okumayı geliştirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cümle okuma, kelimeleri bir araya getirerek doğru ve akıcı şekilde okumayı öğrenme aşamasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cümle okunurken harflerin mahrecine, harekelere ve diğer okuma işaretlerine dikkat edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şedde, cezm ve tenvin kuralları cümle içinde de aynı şekilde uygulanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Önce doğru okumaya odaklanılmalı, akıcılık ise zamanla geliştirilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar, ayet okumaya geçiş için sağlam bir temel oluşturur.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
