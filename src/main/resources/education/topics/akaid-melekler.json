{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Melekler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Melekler Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Melekler, Allah Teâlâ'nın nurdan yarattığı, O'nun emirlerini eksiksiz yerine getiren, gözle görülmeyen varlıklardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Melekler; yemez, içmez, uyumaz, günah işlemez ve Allah'a asla isyan etmezler. Onlar yalnızca Allah'ın emrettiklerini yaparlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Meleklere iman etmek, imanın altı şartından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Meleklere İmanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Meleklere iman, İslam'ın temel inanç esaslarından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Meleklere iman sayesinde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın görünmeyen varlıkları yarattığına inanılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İman güçlenir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İnsanın yaptığı her davranışın kaydedildiği bilinci gelişir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın evrendeki düzeni melekler aracılığıyla yürüttüğü anlaşılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslüman, sorumluluk bilinciyle yaşamaya çalışır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Meleklerin Özellikleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam'a göre meleklerin bazı özellikleri şunlardır:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Nurdan yaratılmışlardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın emirlerine daima itaat ederler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günah işlemezler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yemez, içmez ve uyumazlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Erkeklik ve dişilik özellikleri yoktur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gözle görülmezler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın verdiği görevleri eksiksiz yerine getirirler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Büyük Melekler ve Görevleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam'da adı geçen dört büyük melek şunlardır:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cebrâil (as)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın vahyini peygamberlere getiren melektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Mikâil (as)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yağmur, rüzgâr ve tabiat olayları gibi Allah'ın verdiği görevleri yerine getirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "İsrâfil (as)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kıyametin kopacağı zaman ve yeniden dirilişte Sûr'a üfleyecek melektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Azrâil (as)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın emriyle insanların canını almakla görevli melektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Diğer Görevli Melekler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an ve hadislerde görevleri bildirilen başka melekler de vardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bunlardan bazıları:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kirâmen Kâtibîn: İnsanların iyi ve kötü amellerini yazarlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Münker ve Nekîr: Kabirde insanlara sorular soran meleklerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hamele-i Arş: Allah'ın izniyle Arş'ı taşıyan meleklerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hafaza Melekleri: Allah'ın izniyle insanları korumakla görevli meleklerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Meleklere İmanın Günlük Hayata Etkileri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Meleklere iman eden Müslüman;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Davranışlarına daha çok dikkat eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günahlardan kaçınmaya çalışır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İyi ameller işlemeye gayret eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın her şeyi bildiğini unutmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sorumluluk bilinciyle hareket eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Meleklerden Alınacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Melekler bizlere önemli mesajlar verir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın emirlerine itaat etmek gerekir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İyi davranışlar önemlidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her davranışımız kayıt altındadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Görmediğimiz varlıklara da Allah'ın bildirdiği şekilde iman ederiz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İman, sadece görülen varlıklara değil, gayb âlemine de inanmayı kapsar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Peygamber, Rabbinden kendisine indirilene iman etti; müminler de iman ettiler. Hepsi Allah'a, meleklerine, kitaplarına ve peygamberlerine iman ettiler...\"\n(Bakara Suresi, 2/285)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"...Kim Allah'ı, meleklerini, kitaplarını, peygamberlerini ve ahiret gününü inkâr ederse derin bir sapıklığa düşmüştür.\"\n(Nisâ Suresi, 4/136)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, meleklere imanın İslam'ın temel inanç esaslarından biri olduğunu göstermektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Melekler, Allah'ın nurdan yarattığı varlıklardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Meleklere iman, imanın altı şartından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Melekler Allah'a asla isyan etmez ve O'nun emirlerini yerine getirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dört büyük melek; Cebrâil, Mikâil, İsrâfil ve Azrâildir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kirâmen Kâtibîn melekleri insanların amellerini yazar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Melekler, Allah'ın nurdan yarattığı ve yalnızca O'nun emirlerini yerine getiren görünmeyen varlıklardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Meleklere iman, İslam'ın altı iman esasından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Melekler günah işlemez, Allah'a isyan etmez ve kendilerine verilen görevleri eksiksiz yerine getirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cebrâil vahyi getirir, Mikâil tabiat olaylarıyla ilgili görevleri yerine getirir, İsrâfil Sûr'a üfler, Azrâil ise Allah'ın emriyle can alma görevi yapar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Meleklere iman, Müslümanın sorumluluk bilincini artırır ve iyi davranışlara yönelmesine katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
