{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Vahyin İnişi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Vahiy Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Vahiy, Allah Teâlâ'nın peygamberlerine, dilediği hükümleri ve mesajları doğrudan veya melek aracılığıyla bildirmesidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim, Allah tarafından Cebrâil (a.s.) aracılığıyla Hz. Muhammed'e (sav) vahiy yoluyla indirilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an Nasıl İndirildi?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim, tek seferde değil, yaklaşık 23 yıl boyunca parça parça indirilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu süreç;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Mekke döneminde yaklaşık 13 yıl,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Medine döneminde yaklaşık 10 yıl",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "devam etmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ayetler, yaşanan olaylara, sorulan sorulara ve toplumun ihtiyaçlarına göre nazil olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Vahyin Geliş Şekli",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an vahiyleri, Allah'ın emriyle Cebrâil (a.s.) tarafından Hz. Muhammed'e (sav) ulaştırılmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Vahiy geldiğinde Peygamber Efendimiz (sav):",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Büyük bir manevi sorumluluk hissederdi.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bazen vahyin ağırlığını fiziksel olarak da hissederdi.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gelen ayetleri dikkatle ezberlerdi.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Daha sonra vahiy kâtiplerine yazdırır ve sahabilere öğretirdi.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an Neden Parça Parça İndirildi?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an'ın peyderpey indirilmesinin birçok hikmeti vardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bunlardan bazıları şunlardır:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ayetlerin daha kolay ezberlenmesini sağlamak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslümanların hükümleri zaman içinde öğrenmesini kolaylaştırmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yaşanan olaylara rehberlik etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müminlerin imanını güçlendirmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamber Efendimizi (sav) desteklemek ve teselli etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu yöntem sayesinde Kur'an hem yaşanmış hem de kolayca öğrenilip korunmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Vahiy Kâtipleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav), gelen vahiyleri ezberlemekle yetinmemiş, aynı zamanda yazdırmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu görev için birçok sahabi vahiy kâtibi olarak görev yapmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bunlardan bazıları:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Ebû Bekir (ra)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Ömer (ra)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Osman (ra)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Ali (ra)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Zeyd bin Sâbit",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Muâviye bin Ebû Süfyân",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Vahiyler deri, parşömen, ince taşlar, hurma dalları ve kemik gibi yazı yazılabilen malzemelere kaydedilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Vahyin Korunması",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim yalnızca yazıyla değil, ezber yoluyla da korunmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sahabiler;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ayetleri ezberliyor,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namazlarda okuyordu,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Birbirlerine öğretiyordu.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu sayede Kur'an hem yazılı hem sözlü olarak güvenle muhafaza edilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Şüphesiz o Zikri (Kur'an'ı) biz indirdik, onun koruyucusu da elbette biziz.\"\n(Hicr Suresi, 15/9)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Vahyin İnişi Tamamlandıktan Sonra",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'in indirilişi, Hz. Muhammed'in (sav) vefatından kısa süre önce tamamlanmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Veda Haccı sırasında nazil olan ayetlerden biri şöyledir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Bugün sizin için dininizi kemale erdirdim, üzerinizdeki nimetimi tamamladım ve sizin için din olarak İslam'ı seçtim.\"\n(Mâide Suresi, 5/3)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayet, İslam dininin hükümlerinin tamamlandığını bildirmektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Vahyin İnişinden Çıkarılacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an, Allah'ın koruması altındadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an'ın hükümleri insanları doğru yola yönlendirmek için indirilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İlim ve öğrenme zaman içinde sabırla gelişir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an'ı okumak kadar anlamak ve hayatımıza uygulamak da önemlidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın rehberliği her dönemde insanlar için en güvenilir yol göstericidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an ve Hadislerde Vahyin İnişi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Biz Kur'an'ı insanlara dura dura okuman için bölüm bölüm indirdik.\"\n(İsrâ Suresi, 17/106)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette şöyle buyrulur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Şüphesiz o Zikri (Kur'an'ı) biz indirdik ve onu mutlaka koruyacağız.\"\n(Hicr Suresi, 15/9)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Âişe (ra), vahyin gelişi sırasında Hz. Muhammed'in (sav) vahyin ağırlığını hissettiğini rivayet etmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an, Cebrâil (a.s.) aracılığıyla vahiy yoluyla indirilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Vahiy yaklaşık 23 yılda tamamlanmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an olaylara ve ihtiyaçlara göre parça parça nazil olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Vahiyler hem ezberlenmiş hem de vahiy kâtipleri tarafından yazıya geçirilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah, Kur'an'ın korunacağını bizzat bildirmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Vahiy, Allah'ın peygamberlerine gönderdiği ilahi mesajdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim, Cebrâil (a.s.) aracılığıyla Hz. Muhammed'e (sav) yaklaşık 23 yıl boyunca parça parça indirilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu yöntem, ayetlerin kolay öğrenilmesini, uygulanmasını ve korunmasını sağlamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sahabiler Kur'an'ı ezberlemiş, vahiy kâtipleri ise yazıya geçirmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an'ın korunması Allah'ın güvencesi altındadır ve Müslümanlar için kıyamete kadar yol gösterici olmaya devam edecektir.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
