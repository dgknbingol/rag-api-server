{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Anadolu Selçuklu",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Anadolu Selçuklu Devleti Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçuklu Devleti (Türkiye Selçuklu Devleti), 1077 yılında Anadolu'da kurulmuş önemli bir Türk-İslam devletidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devletin kurucusu Süleyman Şah'tır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkenti önce İznik, daha sonra Konya olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçukluları, Malazgirt Zaferi'nden sonra Anadolu'nun Türkleşmesi ve İslamlaşmasında büyük rol oynamışlardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Anadolu Selçuklu Devleti'nin Kuruluşu",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1071 Malazgirt Zaferi'nin ardından Türkler Anadolu'ya yerleşmeye başlamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kutalmışoğlu Süleyman Şah, 1077 yılında Anadolu Selçuklu Devleti'ni kurmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İlk başkent İznik olmuştur. Ancak I. Haçlı Seferi sırasında İznik kaybedilince başkent Konya'ya taşınmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Önemli Hükümdarlar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Süleyman Şah",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devletin kurucusudur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İznik'i başkent yapmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu'da Türk hâkimiyetini güçlendirmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "I. Kılıç Arslan",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "I. Haçlı Seferi'ne karşı mücadele etmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkenti Konya'ya taşımıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devletin yeniden güçlenmesini sağlamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "I. Alâeddin Keykubad",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçuklu Devleti'nin en güçlü hükümdarlarından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Onun döneminde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devlet en parlak dönemini yaşamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Alanya fethedilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret gelişmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kervansaraylar yaptırılmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu'da güvenlik artırılmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ticaret ve Ekonomi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçukluları ticarete büyük önem vermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu amaçla;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kervansaraylar inşa edilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret yolları güven altına alınmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Liman şehirleri geliştirilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yerli ve yabancı tüccarlara kolaylıklar sağlanmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu sayede Anadolu önemli bir ticaret merkezi hâline gelmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kervansaraylar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kervansaraylar;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tüccarların konakladığı,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hayvanların dinlendirildiği,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Malların korunduğu",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "güvenli yapılardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yolcular burada ücretsiz olarak barınabilir, yemek yiyebilir ve ihtiyaçlarını karşılayabilirdi.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Mimari ve Kültür",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçukluları birçok önemli eser bırakmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başlıca eserleri:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Camiler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Medreseler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kervansaraylar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kümbetler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Köprüler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şifahaneler (hastaneler)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu eserlerin birçoğu günümüzde de ayaktadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kösedağ Savaşı (1243)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1243 yılında Anadolu Selçuklu Devleti ile Moğollar arasında Kösedağ Savaşı yapılmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Savaşın sonucu:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçuklu Devleti yenilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Moğollara bağlı hâle gelmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Devlet zayıflamaya başlamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Anadolu Selçuklu Devleti'nin Yıkılışı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kösedağ Savaşı'ndan sonra;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Moğol baskısı,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İç karışıklıklar,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Taht mücadeleleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "devleti zayıflatmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1308 yılında Anadolu Selçuklu Devleti tamamen sona ermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yerine Anadolu'da birçok Türk Beyliği kurulmuştur. Bu beyliklerden biri de daha sonra büyük bir devlet hâline gelecek olan Osmanlı Beyliğidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Anadolu Selçuklularından Alınacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçukluları bizlere önemli mesajlar verir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu'nun Türkleşmesinde büyük rol oynamışlardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticaret ve ekonomiye önem vermişlerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bilim, eğitim ve mimariye katkı sağlamışlardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Güçlü ulaşım ve ticaret ağı kurmuşlardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Birlik ve beraberliğin önemi tarih boyunca görülmüştür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Yeryüzünde dolaşın da Allah'ın yaratmaya nasıl başladığını görün.\"\n(Ankebût Suresi, 29/20)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Hiç bilenlerle bilmeyenler bir olur mu?\"\n(Zümer Suresi, 39/9)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, ilim öğrenmenin, tarihî eserlerden ibret almanın ve medeniyetleri tanımanın önemine işaret etmektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçuklu Devleti 1077-1308 yılları arasında hüküm sürmüştür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kurucusu Kutalmışoğlu Süleyman Şah'tır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İlk başkenti İznik, daha sonra Konya olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "I. Alâeddin Keykubad döneminde devlet en güçlü zamanını yaşamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1243 Kösedağ Savaşı, devletin zayıflamasına neden olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçuklularından sonra Anadolu'da Türk beylikleri kurulmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçuklu Devleti, 1077 yılında Süleyman Şah tarafından kurulmuş ve Anadolu'nun Türkleşmesi ile İslamlaşmasında önemli rol oynamıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başkent önce İznik, daha sonra Konya olmuştur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "I. Alâeddin Keykubad döneminde ticaret, mimari ve ekonomi büyük gelişme göstermiş; kervansaraylar ve önemli eserler inşa edilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "1243 Kösedağ Savaşı'ndan sonra devlet Moğol baskısı altında zayıflamış ve 1308 yılında sona ermiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anadolu Selçukluları, Anadolu'da Türk-İslam medeniyetinin temellerini güçlendirmiş ve kendilerinden sonra kurulan beyliklere önemli bir miras bırakmıştır.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
