{
  "readingMinutes": 3,
  "blocks": [
    {
      "type": "heading",
      "text": "Med",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Med Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med, Kur'an-ı Kerim okunurken bazı harflerin belirli ölçüde uzatılarak okunmasına verilen isimdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Med\" kelimesi Arapçada \"uzatmak\" anlamına gelir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an okurken her uzatma aynı değildir. Bazı yerlerde harfler normal okunurken, bazı yerlerde ise belirli kurallara göre uzatılır. Bu kurallara med kuralları denir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Med Neden Yapılır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med, Kur'an'ın doğru ve güzel okunmasını sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru uygulanan med;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an'ın aslına uygun okunmasına yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okumanın daha güzel ve akıcı olmasını sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin ve kelimelerin doğru telaffuz edilmesine katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid kurallarının doğru uygulanmasını destekler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Med Harfleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med üç harfle yapılır:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ا (Elif)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "و (Vav)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ي (Ye)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ancak bu harflerin med harfi olabilmesi için belirli şartların bulunması gerekir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Med Harflerinin Kullanılışı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Elif (ا)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eliften önce üstün (fetha) bulunursa elif med harfi olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnek:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "قَالَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Burada \"ا\" uzatılarak okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Vav (و)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Vavdan önce ötre (damme) bulunursa vav med harfi olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnek:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "يَقُولُ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Burada \"و\" uzatılarak okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ye (ي)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yeden önce esre (kesra) bulunursa ye med harfi olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Örnek:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "قِيلَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Burada \"ي\" uzatılarak okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Med Ne Kadar Uzatılır?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an okumada uzatma miktarı, medin türüne göre değişebilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Temel seviyede bilinmesi gereken ilk kural şudur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Normal med (Med-i Tabiî), iki hareke miktarı uzatılarak okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Diğer med çeşitleri ilerleyen derslerde ayrıntılı olarak öğrenilecektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Med Okurken Nelere Dikkat Edilmelidir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gerektiği kadar uzatılmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gereğinden fazla uzatılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Uzatılmaması gereken yerlerde med yapılmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harfin mahreci korunmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med uygulanırken okumanın akıcılığı bozulmamalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Alıştırmalar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Aşağıdaki örnekleri dikkatlice okuyunuz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "قَالَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "نُورٌ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "قِيلَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "آمَنَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "يَقُولُ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "يُؤْمِنُونَ",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu örneklerde med harflerini belirleyerek uygun şekilde uzatmaya çalışınız.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Sık Yapılan Hatalar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med yapılması gereken yerde harfi uzatmamak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gereğinden fazla uzatmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med olmayan harfleri uzatmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Uzatma sırasında harfin mahrecini değiştirmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru med, belirlenen ölçü kadar ve doğal bir şekilde yapılmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an ve Hadislerde Kur'an'ı Güzel Okumanın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı tane tane, ağır ağır oku.\"\n(Müzzemmil Suresi, 73/4)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı seslerinizle güzelleştiriniz.\" (Ebû Dâvûd, Vitir)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med, bazı harflerin belirli ölçüde uzatılarak okunmasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med harfleri elif (ا), vav (و) ve ye (ي)'dir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med harflerinin kullanılabilmesi için belirli şartlar bulunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med-i Tabiî iki hareke miktarı uzatılarak okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med uygulanırken ne eksik ne de fazla uzatma yapılmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med, Kur'an-ı Kerim'de bazı harflerin belirli kurallara göre uzatılarak okunmasıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med harfleri elif, vav ve yedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Eliften önce üstün, vavdan önce ötre ve yeden önce esre bulunduğunda bu harfler med görevi görür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Temel med olan Med-i Tabiî iki hareke miktarı uzatılarak okunur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Med kurallarına uymak, Kur'an'ın doğru, güzel ve usulüne uygun okunmasına katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
