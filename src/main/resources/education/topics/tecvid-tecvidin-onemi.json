{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Tecvidin Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Tecvidin Önemi Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid, Kur'an-ı Kerim'i Allah Teâlâ'nın indirdiği şekle en uygun biçimde okumaya gayret etmeyi sağlayan kurallar bütünüdür.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'i doğru okumak, hem ibadetin güzelliğini artırır hem de yanlış telaffuzdan kaynaklanabilecek hataların önüne geçer.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid, Kur'an okumayı daha doğru, daha güzel ve daha anlaşılır hâle getirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'ı Doğru Okumayı Sağlar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an'daki her harfin kendine ait bir mahreci ve okunuş şekli vardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid kuralları sayesinde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harfler doğru telaffuz edilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harfler birbirine karıştırılmaz.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okuma hataları en aza indirilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Böylece Kur'an, aslına uygun şekilde okunmaya çalışılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Anlamın Korunmasına Yardımcı Olur",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an'da bazı harflerin yanlış okunması, kelimenin anlamını değiştirebilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid kuralları;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin doğru okunmasını,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kelimelerin doğru telaffuz edilmesini,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ayetlerin doğru aktarılmasını",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "sağlamaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu nedenle tecvid, yalnızca güzel okumak için değil, doğru okumak için de önemlidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'ı Güzel Okumaya Katkı Sağlar",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid kuralları uygulandığında Kur'an tilaveti daha düzenli ve daha güzel olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru mahreç, uygun uzatma ve doğru duraklar;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okumanın akıcılığını artırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Dinleyenin daha rahat takip etmesini sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an tilavetine ayrı bir güzellik kazandırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Peygamberimizin Okuyuşunu Örnek Almak",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav), Kur'an'ı Cebrâil'den aldığı şekilde okumuş ve ümmetine de bu okuyuşu öğretmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid öğrenmek, Peygamber Efendimizin (sav) öğrettiği okuyuşa uygun okumaya gayret etmektir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Sabır ve Düzenli Çalışma Gerektirir",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid kısa sürede öğrenilecek bir ilim değildir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru telaffuz ve kurallar;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sürekli uygulama,",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sabırlı çalışma",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "ile zamanla gelişir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her gün yapılan kısa çalışmalar büyük ilerleme sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Tecvid Öğrenmenin Faydaları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid öğrenen kişi;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an'ı daha doğru okur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin mahreçlerini daha iyi uygular.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okuma hatalarını azaltır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an okurken daha güvenli hisseder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tilavetini zamanla daha güzel hâle getirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Tecvidi Hayat Boyu Geliştirmek",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid öğrenmek belirli bir seviyeye ulaştıktan sonra sona eren bir süreç değildir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an okundukça;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Telaffuz gelişir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hatalar azalır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Akıcılık artar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Okuma daha bilinçli hâle gelir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu nedenle tecvid, hayat boyunca geliştirilmeye devam edilen bir ilimdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an ve Hadislerde Tecvidin Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an-ı Kerim'de Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı tane tane, ağır ağır oku.\"\n(Müzzemmil Suresi, 73/4)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette şöyle buyrulur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kendilerine kitap verdiğimiz kimseler onu gereği gibi okurlar.\"\n(Bakara Suresi, 2/121)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hz. Muhammed (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Kur'an'ı seslerinizle güzelleştiriniz.\" (Ebû Dâvûd, Vitir)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid, Kur'an'ın doğru ve güzel okunmasına yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin doğru telaffuzu, anlamın korunmasına katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid kuralları okuma hatalarını azaltır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar ve uygulama ile tecvid becerisi gelişir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid öğrenmek, Kur'an'ı daha bilinçli ve özenli okumaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid, Kur'an-ı Kerim'i doğru ve güzel okumayı sağlayan önemli bir ilimdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Harflerin doğru telaffuz edilmesi ve okuma kurallarına uyulması, Kur'an'ın doğru okunmasına katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Tecvid, hem okuma hatalarını azaltır hem de tilavetin daha güzel ve akıcı olmasını destekler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamber Efendimizin (sav) öğrettiği okuyuşa uygun okumaya gayret etmek tecvidin temel amaçlarındandır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Düzenli tekrar ve sabırlı çalışma ile tecvid bilgisi zamanla gelişir.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
