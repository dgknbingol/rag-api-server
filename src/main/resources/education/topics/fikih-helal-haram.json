{
  "readingMinutes": 4,
  "blocks": [
    {
      "type": "heading",
      "text": "Helal-Haram",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Helal ve Haram Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal, İslam dinine göre yapılması, yenilmesi, içilmesi veya kullanılması dinen izin verilen şeylerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Haram ise Allah'ın ve Peygamberimizin yasakladığı, yapılması veya kullanılması dinen kesin olarak yasak olan davranış ve şeylerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslüman, hayatını helal sınırları içinde yaşamaya ve haramlardan kaçınmaya gayret eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Helal ve Haramın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal ve haram hükümleri, insanların dünya ve ahiret mutluluğunu korumayı amaçlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helale dikkat eden kişi;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın emirlerine uymuş olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Vicdan huzuru kazanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Toplumda güven oluşturur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kul haklarına daha çok dikkat eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sağlıklı ve düzenli bir hayat sürmeye çalışır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Helal Olan Davranışlara Örnekler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam'da birçok davranış helaldir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bunlardan bazıları şunlardır:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal yoldan çalışıp kazanç elde etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Anne ve babaya iyilik etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğru sözlü olmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yardımlaşmak ve sadaka vermek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Emanete sahip çıkmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Ticarette dürüst davranmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İsraf etmeden Allah'ın nimetlerinden faydalanmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Haram Olan Davranışlara Örnekler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kur'an ve sünnette açıkça yasaklanan bazı davranışlar şunlardır:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yalan söylemek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hırsızlık yapmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Faiz almak ve vermek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kumar oynamak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İçki ve uyuşturucu kullanmak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Gıybet etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kul hakkı yemek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Zina etmek.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Haksız yere cana kıymak.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu yasaklar hem bireyi hem de toplumu korumayı amaçlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Helal Kazancın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İslam'da helal kazanç büyük önem taşır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamber Efendimiz (sav), alın teriyle kazanılan rızkı övmüş ve dürüst ticareti teşvik etmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal kazanç;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İbadetlerin bereketine katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Toplumda güven ortamı oluşturur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Haksız kazancı önler.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın rızasını kazanmaya vesile olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Şüpheli İşlerden Kaçınmak",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bazen bir davranışın helal mi haram mı olduğu açık olmayabilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu gibi durumlarda Müslümanın dikkatli davranması ve şüpheli işlerden uzak durması tavsiye edilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamber Efendimiz (sav) şöyle buyurmuştur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Helal bellidir, haram da bellidir. Bu ikisi arasında şüpheli şeyler vardır...\"",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu hadis, kişinin dinini ve vicdanını koruması için şüpheli durumlardan kaçınmasının önemini göstermektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Helal ve Haramdan Alınacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal ve haram hükümleri bizlere önemli mesajlar verir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ın emir ve yasaklarına uymak gerekir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal kazanç tercih edilmelidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kul hakkından kaçınılmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Doğruluk ve dürüstlük hayatın temel ilkeleri olmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Şüpheli durumlardan uzak durmak dinî hassasiyetin göstergesidir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Ey insanlar! Yeryüzündeki helal ve temiz olan şeylerden yiyin...\"\n(Bakara Suresi, 2/168)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Ey iman edenler! Mallarınızı aranızda haksız yollarla yemeyin...\"\n(Nisâ Suresi, 4/29)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, helal kazancın ve haramlardan kaçınmanın önemini göstermektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal, dinen izin verilen; haram ise dinen kesin olarak yasaklanan şeylerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal ve haram hükümleri Kur'an ve sünnete dayanır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal kazanç elde etmek Müslümanın önemli görevlerindendir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Haramlardan ve şüpheli işlerden kaçınmak tavsiye edilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal-haram bilinci, bireyin ve toplumun huzuruna katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal, İslam'ın izin verdiği; haram ise kesin olarak yasakladığı davranış ve şeylerdir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslüman, hayatını helal sınırları içinde yaşamaya ve haramlardan uzak durmaya çalışmalıdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal kazanç, dürüstlük ve kul hakkına riayet İslam'ın temel ilkelerindendir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Faiz, kumar, içki, hırsızlık, yalan ve gıybet gibi davranışlar haram kabul edilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Helal ve haram hükümleri, bireyin ahlakını korumayı ve toplumda adalet ile güveni sağlamayı amaçlar.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
