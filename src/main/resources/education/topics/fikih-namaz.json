{
  "readingMinutes": 3,
  "blocks": [
    {
      "type": "heading",
      "text": "Namaz",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Namaz Nedir?",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz, Allah'a kulluk etmek amacıyla belirli vakitlerde yerine getirilen, tekbir ile başlayıp selam ile sona eren en önemli ibadetlerden biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz, İslam'ın beş şartından biridir ve akıl sağlığı yerinde olan, ergenlik çağına ulaşmış her Müslüman için belirli şartlar altında farzdır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz, kulun Allah ile bağını güçlendirir, manevi huzur kazandırır ve insanı kötü davranışlardan uzaklaştırmaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Namazın Önemi",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz, İslam'daki en önemli ibadetlerden biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz sayesinde;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'a kulluk yerine getirilir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Manevi huzur kazanılır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günahlardan sakınmaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Disiplinli bir hayat alışkanlığı oluşur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslümanlar birlik ve beraberlik içinde ibadet eder.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Peygamber Efendimiz (sav), namazı dinin direği olarak nitelendirmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Beş Vakit Namaz",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslümanlara her gün beş vakit namaz farz kılınmıştır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bunlar:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sabah Namazı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Öğle Namazı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İkindi Namazı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Akşam Namazı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Yatsı Namazı",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Her namazın belirli bir vakti vardır ve vakti içinde kılınması gerekir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Namazın Farzları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namazın geçerli olması için yerine getirilmesi gereken farzlar vardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Namazın Şartları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaza başlamadan önce yerine getirilmesi gereken şartlar:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hadesten taharet (abdestli veya gerektiğinde gusüllü olmak)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Necasetten taharet (beden, elbise ve namaz yeri temizliği)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Setr-i avret (örtülmesi gereken yerleri örtmek)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kıbleye yönelmek",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Vaktin girmiş olması",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Niyet etmek",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Namazın Rükünleri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namazın içinde yerine getirilen temel hareketler:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "İftitah tekbiri",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kıyam",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kıraat",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Rükû",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Secde",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Son oturuş (Ka'de-i Ahîre)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Namazın Faydaları",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'a yakınlaşmayı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sabrı ve disiplini geliştirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kalbe huzur verir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günlük hayatın düzenli olmasına katkı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kötülüklerden uzak durmaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Cemaatle Namaz",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Mümkün olduğunda namazı cemaatle kılmak tavsiye edilmiştir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cemaatle namaz;",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Birlik ve beraberliği güçlendirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kardeşlik duygusunu artırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Müslümanlar arasında dayanışmayı geliştirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Namazdan Alınacak Dersler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz bizlere önemli mesajlar verir:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah'ı sürekli hatırlamayı sağlar.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Hayatı disiplinli yaşamaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Sabrı ve şükrü öğretir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Kibirden uzaklaştırır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Manevi hayatı güçlendirir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Kur'an'dan Mesaj",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Allah Teâlâ şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Namazı dosdoğru kılın, zekâtı verin ve rükû edenlerle birlikte rükû edin.\"\n(Bakara Suresi, 2/43)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Başka bir ayette ise şöyle buyurur:",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "\"Şüphesiz namaz, hayâsızlıktan ve kötülükten alıkoyar.\"\n(Ankebût Suresi, 29/45)",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Bu ayetler, namazın hem Allah'a kulluğun hem de güzel ahlakın önemli bir parçası olduğunu göstermektedir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Bilmeniz Gerekenler",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz, İslam'ın beş şartından biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günde beş vakit farz namaz vardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz belirli vakitlerde kılınır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namazın şartları ve rükünleri vardır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz, Allah'a kulluğun en önemli ibadetlerinden biridir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "heading",
      "text": "Ders Özeti",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz, belirli vakitlerde yerine getirilen ve İslam'ın beş şartından biri olan temel ibadettir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Günde beş vakit farz namaz bulunmaktadır.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namazın geçerli olması için şartlarının, kılınırken ise rükünlerinin yerine getirilmesi gerekir.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Namaz, Allah ile kul arasındaki bağı güçlendirir, manevi huzur kazandırır ve insanı kötülüklerden uzaklaştırmaya yardımcı olur.",
      "title": null,
      "url": null,
      "items": null
    },
    {
      "type": "paragraph",
      "text": "Cemaatle namaz, birlik ve kardeşlik duygularını güçlendiren önemli bir ibadettir.",
      "title": null,
      "url": null,
      "items": null
    }
  ]
}
