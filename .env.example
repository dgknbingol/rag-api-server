# Docker Compose ortam degiskenleri (opsiyonel)
# Kopyala: cp .env.example .env

POSTGRES_DB=aislam
POSTGRES_USER=aislam
POSTGRES_PASSWORD=aislam
POSTGRES_PORT=5432

# RevenueCat webhook — Authorization header degeri (dashboard → Integrations → Webhooks)
REVENUECAT_WEBHOOK_AUTH=

# Ads remote config PUT (Postman: X-Config-Admin-Key)
ADS_CONFIG_ADMIN_KEY=

# AdMob rewarded SSV — Console callback: https://api.e-islam.net/api/ads/ssv/rewarded
ADS_SSV_ENABLED=true
ADS_SSV_REWARDED_AD_UNIT=

# Play Integrity (Android device-session). Credentials: FIREBASE_CREDENTIALS_JSON veya:
# PLAY_INTEGRITY_CREDENTIALS_JSON=
PLAY_INTEGRITY_ENABLED=true
PLAY_INTEGRITY_REQUIRE_RECOGNIZED=false
PLAY_INTEGRITY_REQUIRE_DEVICE=true
PLAY_INTEGRITY_PACKAGE=net.eislam.app

# Apple App Attest (iOS device-session). Team ID = APNS_TEAM_ID de olabilir.
APP_ATTEST_ENABLED=false
APPLE_TEAM_ID=
APP_ATTEST_PRODUCTION=true
APP_ATTEST_BUNDLE_ID=net.eislam.app

# Google Sign-In: virgulle ayrilmis OAuth client ID listesi (web + android)
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_AUDIENCE=net.eislam.app
