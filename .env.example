# Docker Compose ortam degiskenleri (opsiyonel)
# Kopyala: cp .env.example .env

POSTGRES_DB=aislam
POSTGRES_USER=aislam
POSTGRES_PASSWORD=aislam
POSTGRES_PORT=5432

# RevenueCat webhook — Authorization header degeri (dashboard → Integrations → Webhooks)
REVENUECAT_WEBHOOK_AUTH=

# Google Sign-In: virgulle ayrilmis OAuth client ID listesi (web + android)
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_AUDIENCE=net.eislam.app
