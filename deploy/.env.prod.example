# Ilk init DB adi (container ilk acilisinda olusur). Test/prod ayri DB'ler
# sql/split-test-prod-databases.sh ile eklenir: aislam_test, aislam_prod.
POSTGRES_DB=aislam
POSTGRES_USER=aislam
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

AISLAM_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# RevenueCat webhook Authorization (dashboard ile ayni deger)
REVENUECAT_WEBHOOK_AUTH=Bearer rc_wh_BURAYA_SECRET_YAZ

# Push: dogrudan FCM (Android) + APNs (iOS) — Expo Push yok
FIREBASE_CREDENTIALS_JSON=
APNS_KEY_PEM=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=net.eislam.app
APNS_PRODUCTION=true
